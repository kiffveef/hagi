{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {
        "CONTEXT7_API_KEY": ""
      }
    },
    "memory": {
      "disabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@iachilles/memento@latest"
      ],
      "env": {
        "MEMORY_DB_PATH": "${XDG_DATA_HOME:-$HOME/.local/share}/claude-chat-memory/memory.db"
      }
    }
  }
}
